rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function phoneVerified() { return signedIn() && request.auth.token.phone_number != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function approvedDevice(uid) {
      return phoneVerified()
        && exists(/databases/$(database)/documents/trAccountsUsers/$(uid))
        && request.auth.uid in get(/databases/$(database)/documents/trAccountsUsers/$(uid)).data.approvedDevices;
    }

    match /trAccountsUsers/{uid} {
      allow read: if owner(uid) || approvedDevice(uid);
      allow create, delete: if owner(uid);
      allow update: if owner(uid)
        || (approvedDevice(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data', 'updatedAt']));

      match /syncEntries/{entryId} {
        allow read, write: if owner(uid) || approvedDevice(uid);
      }

      match /deviceRequests/{requestId} {
        allow create: if phoneVerified()
          && request.resource.data.requesterUid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.requestedAt is timestamp;
        allow read: if owner(uid)
          || (phoneVerified() && resource.data.requesterUid == request.auth.uid);
        allow update: if (owner(uid)
            && request.resource.data.requesterUid == resource.data.requesterUid
            && request.resource.data.status in ['approved', 'rejected'])
          || (phoneVerified() && resource.data.requesterUid == request.auth.uid
            && resource.data.status == 'rejected'
            && request.resource.data.status == 'pending'
            && request.resource.data.requesterUid == request.auth.uid);
        allow delete: if owner(uid);
      }
    }
  }
}